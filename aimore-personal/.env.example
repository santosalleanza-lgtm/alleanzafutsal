# Copie para .env.local (desenvolvimento) ou cadastre na hospedagem (produção).
# Variáveis NEXT_PUBLIC_* vão para o navegador; as demais ficam só no servidor.
# Depois de mudar uma NEXT_PUBLIC_*, gere um novo build.

# Endereço público do site, sem barra no final (usado em links de e-mail, Mercado Pago e SEO)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# WhatsApp com DDI + DDD, só números. Também pode ser alterado no painel.
NEXT_PUBLIC_WHATSAPP_NUMBER=5551991925356
# E-mail de contato exibido no site (opcional)
NEXT_PUBLIC_CONTACT_EMAIL=

# Logo oficial (opcional). Coloque o arquivo em public/img/ e informe o caminho.
NEXT_PUBLIC_LOGO_URL=

# --- Supabase (banco, login, imagens) ---------------------------------------
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: nunca exponha no navegador nem no repositório.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Pago (pagamento da loja) ----------------------------------------
# Mercado Pago Developers > Suas integrações > Credenciais de produção
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta exibida ao configurar Webhooks (evento "Pagamentos")
MERCADOPAGO_WEBHOOK_SECRET=

# --- Hotmart (liberação de programas) ----------------------------------------
# Hotmart > Ferramentas > Webhook (API e notificações) > token "hottok"
HOTMART_HOTTOK=

# --- Frete ----------------------------------------------------------------
# "combinar" (padrão): frete informado ao cliente depois do pedido.
# "fixo": cobra STORE_SHIPPING_FIXED_CENTS (em centavos) junto com os produtos.
STORE_SHIPPING_MODE=combinar
STORE_SHIPPING_FIXED_CENTS=

# --- Análise de uso (opcional, só carrega após aceite de cookies) ------------
NEXT_PUBLIC_GA_ID=
